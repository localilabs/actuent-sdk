{
  "name": "@actuent/sdk",
  "version": "0.10.0",
  "description": "Actuent SDK: search websites and products as structured data, ask a site, find similar sites, and tools for the Vercel AI SDK and LangChain",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "AI",
    "LAWP",
    "MCP",
    "actuent",
    "agents",
    "langchain",
    "tools",
    "vercel-ai-sdk"
  ],
  "author": "localilabs",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/localilabs/actuent-sdk"
  },
  "homepage": "https://docs.actuent.ai/#sdk",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "ai": ">=4",
    "@langchain/core": ">=0.3"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "bin": {
    "actuent": "dist/cli.js"
  }
}
